# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Resend API Key (for email delivery)
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email configuration
# From address must be verified in Resend dashboard
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=your-email@gmail.com

# OpenAI API key for Whisper audio transcription (optional)
# When set, episodes are transcribed from audio before intelligence extraction.
# When absent, the pipeline falls back to the RSS description instead.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_WHISPER_API=sk-openai-...
